{
  "manifest_version": 3,
  "name": "Tab Tamer",
  "version": "1.0",
  "description": "Periodically discards old tabs to free up memory",
  "background": {
    "scripts": ["tamer.js"],
    "type": "module"
  },
  "permissions": [
  "tabs",
  "alarms"
  ],
  "browser_specific_settings": {
     "gecko": {
       "id": "@tabtamer",
       "data_collection_permissions": {
         "required": ["none"]
      }
    }
  }
}

